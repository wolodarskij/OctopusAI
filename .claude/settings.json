{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/octopus.py\" hook"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/octopus.py\" hook"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/octopus.py\" hook"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt|elicitation_dialog|elicitation_url_dialog",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/octopus.py\" hook"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "AskUserQuestion|ExitPlanMode|Edit|Write|MultiEdit|NotebookEdit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/octopus.py\" hook"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/octopus.py\" hook",
            "async": true
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/octopus.py\" hook"
          }
        ]
      }
    ]
  },
  "env": {
    "CLAUDE_CODE_DISABLE_TERMINAL_TITLE": "1",
    "CLAUDE_CODE_FORCE_SESSION_PERSISTENCE": "1",
    "CLAUDE_CODE_DISABLE_FAST_MODE": "1",
    "CLAUDE_CODE_SILENT_TURN_REMINDER": "1",
    "CLAUDE_CODE_SILENT_TURN_REMINDER_SECONDS": "300",
    "CLAUDE_CODE_SILENT_TURN_REMINDER_TEXT": "About 5 minutes passed since your last message to the owner. Write one short sentence: what you work on now. Then continue, and write nothing else about your work."
  },
  "permissions": {
    "allow": [
      "Bash(python .aitools/todo.py close:*)",
      "PowerShell(python .aitools/todo.py close:*)",
      "Bash(python .octopus/todo.py close:*)",
      "PowerShell(python .octopus/todo.py close:*)"
    ]
  }
}
