{
  "title": "Perforce: the p4-submit, p4-sync and p4-branch permits, the p4 commands no session runs, and the changelist policy of each launch mode",
  "detect": [".p4config", "p4config.txt", ".p4ignore", "p4ignore.txt"],
  "modePermits": {
    "verify": ["p4-submit", "p4-sync"]
  },
  "permits": {
    "p4-submit": {
      "grants": "send work to the server: submit and shelve",
      "deny": [
        "Bash(p4 submit:*)",
        "Bash(p4 shelve:*)",
        "Bash(p4 unshelve:*)"
      ]
    },
    "p4-sync": {
      "grants": "get the changes of others from the server: sync, update and resolve",
      "deny": [
        "Bash(p4 sync:*)",
        "Bash(p4 update:*)",
        "Bash(p4 flush:*)",
        "Bash(p4 resolve:*)"
      ]
    },
    "p4-branch": {
      "grants": "change streams, branches and workspaces: switch, integrate, merge, copy, populate, client and stream",
      "deny": [
        "Bash(p4 switch:*)",
        "Bash(p4 integrate:*)",
        "Bash(p4 integ:*)",
        "Bash(p4 merge:*)",
        "Bash(p4 copy:*)",
        "Bash(p4 populate:*)",
        "Bash(p4 branch:*)",
        "Bash(p4 client:*)",
        "Bash(p4 workspace:*)",
        "Bash(p4 stream:*)"
      ]
    }
  },
  "deny": [
    {
      "tools": [
        "Bash(p4 revert:*)",
        "Bash(p4 clean:*)",
        "Bash(p4 obliterate:*)",
        "Bash(p4 sync -f:*)",
        "Bash(p4 sync * -f*)",
        "Bash(p4 reconcile -w:*)",
        "Bash(p4 reconcile * -w*)",
        "Bash(p4 shelve -d:*)",
        "Bash(p4 shelve * -d*)",
        "Bash(p4 change -f:*)",
        "Bash(p4 change -d:*)",
        "Bash(p4 submit)",
        "Bash(p4 submit -d:*)"
      ],
      "unless": []
    }
  ],
  "brief": [
    "vcs.perforce.work",
    "vcs.perforce.verify",
    "vcs.perforce.plan",
    "vcs.perforce.review",
    "vcs.perforce.manager"
  ],
  "payload": [
    {
      "from": "rules/",
      "to": ".agents/rules/octopus/perforce/"
    }
  ]
}
